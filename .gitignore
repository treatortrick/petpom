# ── 依赖与构建产物（可再生，不进仓库） ──
node_modules/
src-tauri/target/
src-tauri/gen/
dist/

# ── 系统 / 编辑器噪声 ──
.DS_Store
.vscode/
.idea/
*.log

# ── 本地数据与备份 ──
# 运行时数据库（用户设置 / 番茄记录）
data/
# git bundle 备份文件
*.bundle

# ── 凭据（务必不要提交；需要示例时用 .env.example） ──
.env
.env.*
!.env.example

# ── 资产管线：脚本入库，环境与产物不入库 ──
assets/*
!assets/*.py
!assets/requirements.txt
!assets/README.md
!assets/shiba/

# ── 仅本地保留（交互/动画规格文档、开发工具） ──
docs/
tools/
